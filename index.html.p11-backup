<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NU ITCS — Curriculum Monitor</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      corePlugins: { preflight: false },
    };
  </script>
  <style>
    :root {
      --bg: #0b0f19;
      --glass: rgba(30, 41, 59, 0.65);
      --glass-border: rgba(255, 255, 255, 0.1);
      --primary: #3b82f6;
      --accent: #22d3ee;
      --accent2: #a855f7;
      --success: #34d399;
      --warning: #fbbf24;
      --danger: #f87171;
      --text: #f8fafc;
      --muted: #94a3b8;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Inter', sans-serif;
      background: var(--bg);
      background-image:
        radial-gradient(at 0% 0%, rgba(59, 130, 246, 0.18) 0, transparent 50%),
        radial-gradient(at 100% 100%, rgba(168, 85, 247, 0.12) 0, transparent 50%);
      background-attachment: fixed;
      color: var(--text);
      min-height: 100vh;
      line-height: 1.5;
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    body::-webkit-scrollbar {
      display: none;
    }
    html {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    html::-webkit-scrollbar {
      display: none;
    }
    .container { max-width: 1400px; margin: 0 auto; padding: 24px 20px 60px; }
    h1, h2, h3 { font-weight: 700; }
    .gradient-text {
      background: linear-gradient(90deg, var(--primary), var(--accent), var(--accent2));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .glass {
      background: var(--glass);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 1px solid var(--glass-border);
      border-radius: 20px;
      padding: 24px;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.45);
      margin-bottom: 24px;
    }
    .header { text-align: center; margin-bottom: 32px; }
    .header p { color: var(--muted); margin-top: 8px; font-size: 1.05rem; }
    .major-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 16px;
    }
    .major-card {
      cursor: pointer;
      transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
      padding: 20px;
      border-radius: 16px;
      border: 1px solid var(--glass-border);
      background: rgba(15, 23, 42, 0.5);
    }
    .major-card:hover { transform: translateY(-3px); border-color: var(--accent); }
    .major-card.active {
      border-color: var(--accent);
      box-shadow: 0 0 24px rgba(34, 211, 238, 0.25);
      background: rgba(34, 211, 238, 0.08);
    }
    .major-card h3 { font-size: 1.1rem; margin-bottom: 4px; }
    .major-card .code { color: var(--accent); font-size: 0.85rem; font-weight: 600; }
    .dashboard-main {
      max-width: 1400px;
      margin: 0 auto;
      width: 100%;
    }
    /* Hide scrollbar for Chrome, Safari and Opera */
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    /* Hide scrollbar for IE, Edge and Firefox */
    .no-scrollbar {
      -ms-overflow-style: none;  /* IE and Edge */
      scrollbar-width: none;  /* Firefox */
    }
    /* Global scrollbar hiding */
    * {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    *::-webkit-scrollbar {
      display: none;
    }
    .stats-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px; margin-bottom: 20px; }
    .stat-box {
      background: rgba(15, 23, 42, 0.6);
      border-radius: 12px;
      padding: 16px;
      text-align: center;
      border: 1px solid var(--glass-border);
    }
    .stat-box .val { font-size: 1.75rem; font-weight: 800; color: var(--accent); }
    .stat-box .lbl { font-size: 0.75rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; margin-top: 4px; }
    .progress-bar-wrap {
      height: 10px; background: rgba(15, 23, 42, 0.8); border-radius: 999px; overflow: hidden; margin: 12px 0;
    }
    .progress-bar-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--primary), var(--accent));
      border-radius: 999px;
      transition: width 0.4s ease;
    }
    .track-pills { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
    .pill {
      padding: 8px 14px;
      border-radius: 999px;
      border: 1px solid var(--glass-border);
      background: rgba(15, 23, 42, 0.5);
      cursor: pointer;
      font-size: 0.8rem;
      transition: all 0.2s;
    }
    .pill.active, .pill:hover { border-color: var(--accent2); background: rgba(168, 85, 247, 0.15); }
    .tree-controls { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 16px; align-items: center; }
    .btn {
      padding: 10px 18px;
      border-radius: 10px;
      border: 1px solid var(--glass-border);
      background: rgba(59, 130, 246, 0.2);
      color: var(--text);
      cursor: pointer;
      font-size: 0.85rem;
      font-weight: 500;
      transition: all 0.2s;
    }
    .btn:hover { background: rgba(59, 130, 246, 0.4); border-color: var(--primary); }
    .btn.active { background: var(--primary); border-color: var(--primary); }
    .btn-ghost { background: transparent; }
    .tree-wrap {
      overflow: auto;
      min-height: 500px;
      max-height: 80vh;
      border-radius: 12px;
      background: rgba(15, 23, 42, 0.4);
      padding: 20px;
      border: 1px solid var(--glass-border);
    }
    .course-grid {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }
    .course-card {
      background: rgba(30, 41, 59, 0.8);
      border: 1px solid var(--glass-border);
      border-radius: 12px;
      padding: 16px;
      cursor: pointer;
      transition: all 0.2s ease;
      position: relative;
    }
    .course-card:hover {
      transform: translateY(-2px);
      border-color: var(--accent);
      box-shadow: 0 8px 16px rgba(34, 211, 238, 0.15);
    }
    .course-card.completed {
      border-color: var(--success);
      background: rgba(6, 78, 59, 0.3);
    }
    .course-card.in-progress {
      border-color: var(--accent);
      background: rgba(22, 78, 99, 0.3);
    }
    .course-card.dimmed {
      opacity: 0.2;
      filter: grayscale(0.8);
    }
    .course-card.filter-dimmed {
      opacity: 0.25;
      filter: grayscale(0.6);
    }
    .course-card.highlight-prereq {
      border-color: var(--warning);
      box-shadow: 0 0 12px rgba(251, 191, 36, 0.4);
    }
    .course-card.highlight-unlock {
      border-color: var(--success);
      box-shadow: 0 0 12px rgba(52, 211, 153, 0.4);
    }
    .course-card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
      margin-right: 40px;
      gap: 8px;
      position: relative;
    }
    .course-code {
      font-weight: 700;
      color: var(--accent);
      font-size: 0.95rem;
      flex: 1;
    }
    .course-credits {
      background: rgba(59, 130, 246, 0.2);
      color: var(--primary);
      padding: 2px 8px;
      border-radius: 6px;
      font-size: 0.75rem;
      font-weight: 600;
      white-space: nowrap;
    }
    .course-title {
      font-size: 0.9rem;
      color: var(--text);
      margin-bottom: 8px;
      line-height: 1.4;
    }
    .course-status {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 0.8rem;
      padding: 4px 10px;
      border-radius: 6px;
      font-weight: 500;
    }
    .course-status.completed {
      background: rgba(52, 211, 153, 0.2);
      color: var(--success);
    }
    .course-status.in-progress {
      background: rgba(34, 211, 238, 0.2);
      color: var(--accent);
    }
    .course-status.not-started {
      background: rgba(71, 85, 105, 0.3);
      color: var(--muted);
    }
    .course-prereqs {
      margin-top: 8px;
      font-size: 0.75rem;
      color: var(--muted);
    }
    .course-prereqs span {
      color: var(--warning);
    }
    .course-category {
      font-size: 0.65rem;
      padding: 2px 6px;
      border-radius: 4px;
      background: rgba(168, 85, 247, 0.2);
      color: var(--accent2);
      white-space: nowrap;
    }
    .semester-section {
      margin-bottom: 32px;
    }
    .semester-header {
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--accent);
      margin-bottom: 16px;
      padding-bottom: 8px;
      border-bottom: 2px solid rgba(34, 211, 238, 0.3);
    }
    .semester-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 16px;
    }
    .course-card.placeholder {
      background: rgba(71, 85, 105, 0.3);
      border: 1px dashed var(--muted);
      opacity: 0.7;
    }
    .legend { display: flex; gap: 20px; flex-wrap: wrap; margin-top: 12px; font-size: 0.85rem; }
    .legend span { display: flex; align-items: center; gap: 8px; }
    .dot { width: 12px; height: 12px; border-radius: 50%; }
    .dot.done { background: var(--success); box-shadow: 0 0 8px var(--success); }
    .dot.active { background: var(--accent); box-shadow: 0 0 8px var(--accent); }
    .dot.pending { background: #475569; }
    .dot.highlight-prereq { background: var(--warning); box-shadow: 0 0 8px var(--warning); }
    .dot.highlight-unlock { background: var(--success); box-shadow: 0 0 8px var(--success); }
    table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
    th, td { padding: 10px 12px; text-align: left; border-bottom: 1px solid var(--glass-border); }
    th { color: var(--muted); font-weight: 600; font-size: 0.75rem; text-transform: uppercase; }
    tr:hover td { background: rgba(255, 255, 255, 0.03); }
    tr.row-completed { opacity: 0.75; }
    tr.row-completed td:first-child { color: var(--success); }
    .status-btns { display: flex; gap: 4px; }
    .status-btn {
      width: 28px; height: 28px;
      border-radius: 6px;
      border: 1px solid var(--glass-border);
      background: transparent;
      cursor: pointer;
      font-size: 0.7rem;
      color: var(--muted);
    }
    .status-btn.s-done { background: rgba(52, 211, 153, 0.3); color: var(--success); border-color: var(--success); }
    .status-btn.s-progress { background: rgba(34, 211, 238, 0.2); color: var(--accent); border-color: var(--accent); }
    .catalog-scroll { max-height: 480px; overflow-y: auto; }
    details { margin-bottom: 12px; }
    summary { cursor: pointer; font-weight: 600; padding: 8px 0; }
    .semester-block {
      background: rgba(15, 23, 42, 0.5);
      border-radius: 10px;
      padding: 12px;
      margin-bottom: 10px;
      border: 1px solid var(--glass-border);
    }
    .semester-block h4 { font-size: 0.9rem; margin-bottom: 8px; color: var(--accent); }
    .sem-tags { display: flex; flex-wrap: wrap; gap: 6px; }
    .sem-tag {
      font-size: 0.75rem;
      padding: 4px 10px;
      border-radius: 6px;
      background: rgba(59, 130, 246, 0.15);
      border: 1px solid var(--glass-border);
      cursor: pointer;
    }
    .sem-tag.done { background: rgba(52, 211, 153, 0.2); border-color: var(--success); }
    .alert {
      padding: 12px 16px;
      border-radius: 10px;
      background: rgba(248, 113, 113, 0.15);
      border: 1px solid rgba(248, 113, 113, 0.4);
      color: #fecaca;
      font-size: 0.9rem;
      margin-bottom: 16px;
      display: none;
    }
    .alert.show { display: block; }
    .footer-note {
      text-align: center;
      color: var(--muted);
      font-size: 0.8rem;
      margin-top: 32px;
      padding: 16px 16px 0;
    }
    .hidden { display: none !important; }
    .breakdown-table td:last-child { text-align: right; color: var(--accent); }
    .import-export { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 12px; }
    input[type="file"] { display: none; }
    .header-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
    }
    .sidebar-toggle-btn {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 10px 16px;
      border-radius: 10px;
      border: 1px solid var(--glass-border);
      background: rgba(59, 130, 246, 0.2);
      color: var(--text);
      cursor: pointer;
      font-size: 0.85rem;
      font-weight: 500;
      transition: all 0.2s;
    }
    .sidebar-toggle-btn:hover {
      background: rgba(59, 130, 246, 0.4);
      border-color: var(--primary);
    }
    .sidebar-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.5);
      z-index: 40;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.3s ease, visibility 0.3s ease;
    }
    .sidebar-overlay.open {
      opacity: 1;
      visibility: visible;
    }
    .bylaws-sidebar {
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      z-index: 50;
      width: 320px;
      background: rgba(15, 23, 42, 0.95);
      border-left: 1px solid var(--glass-border);
      box-shadow: -8px 0 32px rgba(0, 0, 0, 0.4);
      transform: translateX(100%);
      transition: transform 0.3s ease-in-out;
      backdrop-filter: blur(14px);
      display: flex;
      flex-direction: column;
    }
    .translate-x-full {
      transform: translateX(100%);
    }
    .translate-x-0 {
      transform: translateX(0);
    }
    .sidebar-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 20px;
      border-bottom: 1px solid var(--glass-border);
      position: sticky;
      top: 0;
      background: rgba(15, 23, 42, 0.95);
      backdrop-filter: blur(14px);
      z-index: 10;
    }
    .sidebar-header h2 {
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--accent);
      margin: 0;
    }
    .sidebar-close-btn {
      background: transparent;
      border: none;
      color: var(--muted);
      cursor: pointer;
      padding: 8px;
      border-radius: 8px;
      transition: all 0.2s;
    }
    .sidebar-close-btn:hover {
      background: rgba(255, 255, 255, 0.1);
      color: var(--text);
    }
    .sidebar-content {
      padding: 20px;
      overflow-y: auto;
      flex: 1;
    }
    .sidebar-section {
      margin-bottom: 24px;
    }
    .sidebar-section h3 {
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--accent);
      margin-bottom: 12px;
      padding-bottom: 8px;
      border-bottom: 1px solid rgba(34, 211, 238, 0.3);
    }
    .sidebar-section ul {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .sidebar-section li {
      padding: 8px 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      font-size: 0.85rem;
      color: var(--muted);
    }
    .sidebar-section li strong {
      color: var(--text);
    }
    @media (min-width: 768px) {
      .bylaws-sidebar {
        width: 384px;
      }
    }
    .category-badge {
      font-size: 0.7rem;
      padding: 2px 8px;
      border-radius: 4px;
      background: rgba(168, 85, 247, 0.2);
      color: var(--accent2);
    }
    .prereq-warn { color: var(--warning); font-size: 0.75rem; }
  </style>
</head>
<body>
  <div class="container">
    <header class="header">
      <div class="header-content">
        <div>
          <h1 class="gradient-text">NU ITCS Curriculum Monitor</h1>
          <p>Nile University — School of IT &amp; Computer Science · Bylaw July 2025</p>
        </div>
        <button id="btn-open-rules" class="sidebar-toggle-btn">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
          </svg>
          <span>Academic Rules</span>
        </button>
      </div>
    </header>

    <section class="glass">
      <h2>Select Your Major</h2>
      <div class="major-grid" id="majorGrid"></div>
    </section>

    <div id="dashboard" class="hidden">
      <main class="dashboard-main">
          <section class="glass">
            <div class="flex flex-wrap items-start justify-between gap-4 mb-2">
              <div class="min-w-0 flex-1">
                <h2 id="programTitle">Program Overview</h2>
                <p id="programMission" style="color:var(--muted);margin:12px 0 0;font-size:0.95rem;"></p>
              </div>
              <button type="button" id="resetProgressBtn" onclick="resetProgress()"
                class="shrink-0 inline-flex items-center justify-center rounded-xl border border-rose-500/50 bg-rose-950/40 px-5 py-2.5 text-sm font-semibold text-rose-300 backdrop-blur-md transition-all duration-200 hover:border-rose-400 hover:bg-rose-900/50 hover:text-rose-200 hover:shadow-[0_0_20px_rgba(244,63,94,0.35)] focus:outline-none focus-visible:ring-2 focus-visible:ring-rose-400/50">
                Reset Progress
              </button>
            </div>
            <div class="stats-row" id="statsRow"></div>
            <div class="progress-bar-wrap"><div class="progress-bar-fill" id="gpaProgress" style="width:0%"></div></div>
            <p style="font-size:0.85rem;color:var(--muted);" id="progressLabel">GPA credits: 0 / 132</p>
            <div class="progress-bar-wrap"><div class="progress-bar-fill" id="totalProgress" style="width:0%;background:linear-gradient(90deg,var(--accent2),var(--accent))"></div></div>
            <p style="font-size:0.85rem;color:var(--muted);" id="totalLabel">Total degree: 0 / 138</p>
            <table class="breakdown-table" style="margin-top:16px;">
              <thead><tr><th>Area</th><th>Credits</th><th>%</th></tr></thead>
              <tbody id="breakdownBody"></tbody>
            </table>
            <div id="trackSection" class="hidden">
              <h3 style="margin-top:20px;font-size:1rem;">CS Specialization Track</h3>
              <div class="track-pills" id="trackPills"></div>
            </div>
          </section>

          <section class="glass">
            <h2>Curriculum Map <span style="font-size:0.85rem;color:var(--muted);font-weight:400;">— Interactive Course Grid</span></h2>
            <div class="tree-controls">
              <button class="btn active" data-view="full" type="button">All Courses</button>
              <button class="btn" data-view="core" type="button">Highlight Core</button>
              <button class="btn" data-view="math" type="button">Highlight Math</button>
              <button class="btn" data-view="spec" type="button">Highlight Specialization</button>
              <button class="btn" data-view="english-electives" type="button">English &amp; Electives</button>
            </div>
            <p style="font-size:0.8rem;color:var(--muted);margin-bottom:12px;">Click cards to cycle status • Hover to see prerequisites • Filters highlight courses by category within their semester slots</p>
            <div id="prereqAlert" class="alert"></div>
            <div class="tree-wrap">
              <div id="courseGrid" class="course-grid"></div>
            </div>
            <div class="legend">
              <span><span class="dot done"></span> Completed</span>
              <span><span class="dot active"></span> In progress</span>
              <span><span class="dot pending"></span> Not started</span>
              <span><span class="dot highlight-prereq"></span> Prerequisite</span>
              <span><span class="dot highlight-unlock"></span> Unlocks</span>
            </div>
          </section>

          <section class="glass">
            <h2>Course Catalog</h2>
            <div class="tree-controls">
              <select id="filterCategory">
                <option value="all">All categories</option>
                <option value="university">University</option>
                <option value="humanities">Humanities &amp; Social</option>
                <option value="math">Math &amp; Sciences</option>
                <option value="basic_computing">Basic Computing</option>
                <option value="specialization">Specialization</option>
                <option value="training">Training</option>
                <option value="project">Graduation Project</option>
              </select>
              <select id="filterStatus">
                <option value="all">All statuses</option>
                <option value="completed">Completed</option>
                <option value="in_progress">In progress</option>
                <option value="not_started">Not started</option>
              </select>
              <div class="relative" style="flex: 1; min-width: 200px;">
                <input type="text" id="searchInput" placeholder="Search courses..." 
                  class="w-full bg-slate-800 text-white border border-slate-700 rounded-lg px-4 py-2 pl-10 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent placeholder-slate-400 text-sm"
                  style="background: rgba(30, 41, 59, 0.8); border: 1px solid rgba(255, 255, 255, 0.1);">
                <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
              </div>
            </div>
            <div class="catalog-scroll">
              <table>
                <thead>
                  <tr>
                    <th>Code</th>
                    <th>Title</th>
                    <th>Cr</th>
                    <th>Category</th>
                    <th>Prerequisites</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody id="catalogBody"></tbody>
              </table>
            </div>
          </section>

          <section class="glass">
            <h2>Suggested Study Plan</h2>
            <div id="studyPlanHost"></div>
          </section>
          
          <section class="glass">
            <h2>Your Progress</h2>
            <div class="import-export">
