};


  const COURSE_CATEGORIES = Object.freeze({
    MATH: 'math',
    SCIENCE: 'science',
    BASIC_COMPUTING: 'basic_computing',
    SPECIALIZATION: 'specialization',
    HUMANITIES: 'humanities',
    ENGLISH: 'english',
    PROJECT: 'project',
    TRAINING: 'training'
  });

  const normalizeCategory = category => category === 'basic computing'
    ? COURSE_CATEGORIES.BASIC_COMPUTING
    : category;

  const summerCourses = {
    general: [
      { code: 'CSCI 291', titleEn: 'Industrial/Research Training I', credits: 3, category: 'training', type: 'summer', year: 2, slotId: 'GENERAL-SUMMER-Y2-CSCI-291-01', prereqs: ['SOPH'] },
      { code: 'CSCI 391', titleEn: 'Industrial/Research Training II', credits: 3, category: 'training', type: 'summer', year: 3, slotId: 'GENERAL-SUMMER-Y3-CSCI-391-01', prereqs: ['JUN'] }
    ],
    ai: [
      { code: 'AIS 291', titleEn: 'Industrial/Research Training I', credits: 3, category: 'training', type: 'summer', year: 2, slotId: 'AI-SUMMER-Y2-AIS-291-01', prereqs: ['SOPH'] },
      { code: 'AIS 391', titleEn: 'Industrial/Research Training II', credits: 3, category: 'training', type: 'summer', year: 3, slotId: 'AI-SUMMER-Y3-AIS-391-01', prereqs: ['JUN'] }
    ],
    biomedical: [
      { code: 'BMD 291', titleEn: 'Industrial/Research Training I', credits: 3, category: 'training', type: 'summer', year: 2, slotId: 'BIOMEDICAL-SUMMER-Y2-BMD-291-01', prereqs: ['SOPH'] },
      { code: 'BMD 391', titleEn: 'Industrial/Research Training II', credits: 3, category: 'training', type: 'summer', year: 3, slotId: 'BIOMEDICAL-SUMMER-Y3-BMD-391-01', prereqs: ['JUN'] }
    ],
    cybersecurity: [
      { code: 'CSEC 291', titleEn: 'Industrial/Research Training I', credits: 3, category: 'training', type: 'summer', year: 2, slotId: 'CYBERSECURITY-SUMMER-Y2-CSEC-291-01', prereqs: ['SOPH'] },
      { code: 'CSEC 391', titleEn: 'Industrial/Research Training II', credits: 3, category: 'training', type: 'summer', year: 3, slotId: 'CYBERSECURITY-SUMMER-Y3-CSEC-391-01', prereqs: ['JUN'] }
    ]
  };

  const makeSlotId = (trackId, course, occurrence) => {
    const token = course.code.replace(/[^A-Za-z0-9]+/g, '-').replace(/^-|-$/g, '').toUpperCase();
    const period = course.type === 'summer' ? `SUMMER-Y${course.year}` : `S${course.semester}`;
    return `${trackId.toUpperCase()}-${period}-${token}-${String(occurrence).padStart(2, '0')}`;
  };

  function buildPrerequisiteRule(course, trackId) {
    if (course.prerequisiteRule) return course.prerequisiteRule;
    if (course.prerequisiteRules) return { type: 'all', requirements: course.prerequisiteRules.map(rule => ({ type: 'course', ...rule })) };
    if (trackId === 'ai' && course.code === 'AIS 301') {
      return { type: 'all', requirements: [{ type: 'course', code: 'AIS 201' }, { type: 'course', code: 'CSCI 331' }] };
    }
    if (trackId === 'biomedical' && course.code === 'BMD 101') {
      return { type: 'any', requirements: [{ type: 'course', code: 'BMD 100' }, { type: 'standing', value: 'science_section' }] };
    }
    if (trackId === 'biomedical' && course.code === 'BMD 102') {
      return { type: 'course', code: 'BMD 101', allowConcurrent: true };
    }
    if (trackId === 'biomedical' && course.code === 'BMD 211') {
      return { type: 'course', code: 'CSCI 231', allowConcurrent: true };
    }

    const requirements = (course.prereqs || []).map(code => {
      if (code === 'SOPH') return { type: 'standing', value: 'sophomore' };
      if (code === 'JUN') return { type: 'standing', value: 'junior' };
      if (code === 'Science Section') return { type: 'standing', value: 'science_section' };
      if (code === 'Math Section') return { type: 'standing', value: 'math_section' };
      if (code === 'SR87' || code === '87 Credit Hours' || code === 'Completing 87 Credit Hours') return { type: 'min_credit_hours', value: 87 };
      if (/High School|Placement Test|Track specific|Junior Level|None|MATH 120 \/ High School Math/i.test(code)) return { type: 'external', label: code };
      return { type: 'course', code };
    });
    return requirements.length === 0 ? null : requirements.length === 1 ? requirements[0] : { type: 'all', requirements };
  }

  function formatPrerequisiteRule(rule) {
    if (!rule) return '';
    if (rule.type === 'all') return rule.requirements.map(formatPrerequisiteRule).filter(Boolean).join(', ');
    if (rule.type === 'any') return rule.requirements.map(formatPrerequisiteRule).filter(Boolean).join(' OR ');
    if (rule.type === 'course') return `${rule.code}${rule.allowConcurrent ? ' OR concurrent' : ''}`;
    if (rule.type === 'standing') return rule.value === 'sophomore' ? 'Sophomore Standing' : rule.value === 'junior' ? 'Junior Standing' : rule.value.replace(/_/g, ' ');
    if (rule.type === 'min_credit_hours') return `Completing ${rule.value} Credit Hours or more`;
    return rule.label || '';
  }

  function validateAuthoredSlotIds() {
    Object.entries(allTracksData).forEach(([trackId, courses]) => {
      const seen = new Set();
      [...courses, ...(summerCourses[trackId] || [])].forEach(course => {
        if (typeof course.slotId !== 'string' || course.slotId.length === 0) {
          throw new Error(`Missing authored slotId: ${trackId}/${course.semester || `Summer ${course.year}`} ${course.code} ${course.titleEn}`);
        }
        if (seen.has(course.slotId)) throw new Error(`Duplicate authored slotId: ${trackId}/${course.slotId}`);
        seen.add(course.slotId);
      });
    });
  }

  validateAuthoredSlotIds();

  const normalizedCourses = Object.fromEntries(Object.entries(allTracksData).map(([trackId, entries]) => {
    const occurrences = new Map();
    const rawEntries = [...entries, ...(summerCourses[trackId] || [])];
    return [trackId, rawEntries.map(course => {
      const occurrence = (occurrences.get(`${course.semester}:${course.code}`) || 0) + 1;
      occurrences.set(`${course.semester}:${course.code}`, occurrence);
      const termType = course.referenceOnly ? 'reference' : course.type === 'summer' ? 'summer' : 'regular';
      const prerequisites = course.prereqs || [];
      const prerequisiteRule = buildPrerequisiteRule(course, trackId);
      return {
        ...course,
        programId: trackId,
        termType,
        slotId: course.slotId || makeSlotId(trackId, course, occurrence),
        category: normalizeCategory(course.category),
        prerequisites,
        prereqs: prerequisites,
        prerequisiteRule,
        prereqText: course.prereqText || formatPrerequisiteRule(prerequisiteRule)
      };
    })];
  }));

  const courseRegistry = new Map(Object.entries(normalizedCourses).map(([trackId, courses]) => [
    trackId,
    new Map(courses.map(course => [course.slotId, course]))
  ]));
  const programTrackIds = { cs: 'general', ai: 'ai', bmd: 'biomedical', csec: 'cybersecurity' };

  const studyPlanOrder = [
    { type: 'semester', semester: 1, label: 'Semester 1' },
    { type: 'semester', semester: 2, label: 'Semester 2' },
    { type: 'semester', semester: 3, label: 'Semester 3' },
    { type: 'semester', semester: 4, label: 'Semester 4' },
    { type: 'summer', year: 2, label: 'Year 2 — Summer' },
    { type: 'semester', semester: 5, label: 'Semester 5' },
    { type: 'semester', semester: 6, label: 'Semester 6' },
    { type: 'summer', year: 3, label: 'Year 3 — Summer' },
    { type: 'semester', semester: 7, label: 'Semester 7' },
    { type: 'semester', semester: 8, label: 'Semester 8' }
  ];
  const trackStudyPlans = Object.fromEntries(Object.entries(normalizedCourses).map(([trackId, entries]) => [
    trackId,
    studyPlanOrder.map(term => ({
      ...term,
      courses: entries.filter(course => term.type === 'summer'
        ? course.termType === 'summer' && course.year === term.year
        : course.termType === 'regular' && course.semester === term.semester
      ).map(course => course.slotId)
    }))
  ]));

  function validateUniqueSlotIds() {
    const seen = new Set();
    Object.values(normalizedCourses).flat().forEach(course => {
      if (seen.has(course.slotId)) throw new Error(`Duplicate slotId: ${course.slotId}`);
      seen.add(course.slotId);
    });
  }

  function validateStudyPlanReferences() {
    Object.entries(trackStudyPlans).forEach(([trackId, plan]) => plan.forEach(semester => {
      semester.courses.forEach(slotId => {
        if (!courseRegistry.get(trackId)?.has(slotId)) {
          console.error(`Missing study-plan reference: ${trackId}/${slotId}`);
        }
      });
    }));
  }

  function validateCanonicalModel() {
    const errors = [];
    const expectedOrder = studyPlanOrder.map(term => term.label).join('|');
    Object.entries(normalizedCourses).forEach(([trackId, courses]) => {
      const seenCodes = new Map();
      courses.forEach(course => {
        if (!course.slotId || !course.programId || !course.code || !course.titleEn || !Array.isArray(course.prerequisites)) {
          errors.push(`${trackId}/${course.slotId || course.code}: malformed canonical course`);
        }
        if (course.termType === 'regular' && (!Number.isInteger(course.semester) || course.semester < 1 || course.semester > 8)) {
          errors.push(`${trackId}/${course.slotId}: invalid semester ${course.semester}`);
        }
        const slots = seenCodes.get(course.code) || [];
        slots.push(course.slotId);
        seenCodes.set(course.code, slots);
      });
      seenCodes.forEach((slots, code) => {
        if (slots.length > 1) console.warn(`Ambiguous course code ${trackId}/${code}: ${slots.join(', ')}`);
      });
      const labels = trackStudyPlans[trackId].map(term => term.label).join('|');
      if (labels !== expectedOrder) errors.push(`${trackId}: invalid study-plan order`);
    });
    if (errors.length) throw new Error(`Canonical curriculum validation failed:\n${errors.join('\n')}`);
  }

  validateUniqueSlotIds();
  validateStudyPlanReferences();
  validateCanonicalModel();

  const PROGRAMS = {
    cs: {
      id: 'cs',
      nameEn: 'Computer Science',
      mission: 'Excellence in IT industries with strong computing foundations and four specialization tracks: Data Engineering, Media Informatics, Software Engineering, and Quantum Computing.',
      creditBreakdown: CREDIT_BREAKDOWN,
      graduation: { total: 138, gpaCredits: 132, minCGPA: 2.0, minSemesters: 7, trainingWeeks: 4 },
      tracks: CS_TRACKS,
      courses: normalizedCourses.general,
      studyPlan: trackStudyPlans.general
    },
    ai: {
      id: 'ai',
      nameEn: 'Artificial Intelligence',
      mission: 'Prepare specialists in AI, machine learning, deep learning, NLP, computer vision, and data science with strong theoretical and practical foundations.',
      creditBreakdown: CREDIT_BREAKDOWN,
      graduation: { total: 138, gpaCredits: 132, minCGPA: 2.0, minSemesters: 7, trainingWeeks: 4 },
      tracks: null,
      courses: normalizedCourses.ai,
      studyPlan: trackStudyPlans.ai
    },
    bmd: {
      id: 'bmd',
      nameEn: 'Biomedical Informatics',
      mission: 'Integrate computing, bioinformatics, clinical systems, and medical data analytics for healthcare and life sciences.',
      creditBreakdown: CREDIT_BREAKDOWN,
      graduation: { total: 138, gpaCredits: 132, minCGPA: 2.0, minSemesters: 7, trainingWeeks: 4 },
      tracks: null,
      courses: normalizedCourses.biomedical,
      studyPlan: trackStudyPlans.biomedical
    },
    csec: {
      id: 'csec',
      nameEn: 'Cybersecurity',
      mission: 'Develop graduates capable of protecting information systems through cryptography, network security, forensics, and secure software practices.',
      creditBreakdown: CREDIT_BREAKDOWN,
      graduation: { total: 138, gpaCredits: 132, minCGPA: 2.0, minSemesters: 7, trainingWeeks: 4 },
      tracks: null,
      courses: normalizedCourses.cybersecurity,
      studyPlan: trackStudyPlans.cybersecurity
    }
  };

  let currentProgram = null;
  let currentTrack = 'dea';
  let treeView = 'full';
  let progress = loadProgress();
  let highlightedCourse = null;

  function loadProgress() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return {};
      const parsed = JSON.parse(raw);
      return parsed && typeof parsed === 'object' && !Array.isArray(parsed) ? parsed : {};
    } catch { return {}; }
  }
  function saveProgress() {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(progress));
      return true;
    } catch (error) {
      console.warn('Progress could not be persisted; in-memory progress remains active.', error);
      return false;
    }
  }
  function migrateLegacyProgress() {
    let changed = false;
    Object.entries(normalizedCourses).forEach(([trackId, courses]) => {
      const programId = Object.entries(programTrackIds).find(([, mappedTrackId]) => mappedTrackId === trackId)?.[0] || trackId;
      const stored = progress[programId];
      if (!stored || typeof stored !== 'object') return;
      const slotIds = new Set(courses.map(course => course.slotId));
      const legacyEntries = Object.entries(stored).filter(([key]) => !slotIds.has(key));
      legacyEntries.forEach(([legacyCode, status]) => {
        const matches = courses.filter(course => course.code === legacyCode && !stored[course.slotId]);
        if (!matches.length) return;
        if (matches.length > 1) {
          stored._legacyAmbiguous = stored._legacyAmbiguous || {};
          if (!(legacyCode in stored._legacyAmbiguous)) stored._legacyAmbiguous[legacyCode] = status;
          return;
        }
        stored[matches[0].slotId] = status;
        delete stored[legacyCode];
        changed = true;
      });
    });
    if (changed) saveProgress();
  }

  function getProgramCourse(programId, slotId) {
    return courseRegistry.get(programTrackIds[programId] || programId)?.get(slotId) || null;
  }

  function getStatus(programId, slotId) {
    return progress[programId]?.[slotId] || 'not_started';
  }

  function resolvePrerequisiteSlots(programId, code, slotId = null) {
    const trackId = programTrackIds[programId] || programId;
    return (normalizedCourses[trackId] || [])
      .filter(course => course.code === code && (!slotId || course.slotId === slotId))
      .map(course => course.slotId);
  }

  const eligibilityContext = { standing: null, sections: new Set(), satisfiedReferenceCodes: new Set() };

  function getCompletedQualifyingCredits(programId) {
    const trackId = programTrackIds[programId] || programId;
    return (normalizedCourses[trackId] || []).reduce((total, course) => {
      if (course.referenceOnly || course.category === 'training' || course.countsGpa === false || getStatus(programId, course.slotId) !== 'completed') return total;
      return total + (Number(course.credits) || 0);
    }, 0);
  }

  function evaluatePrerequisite(rule, context) {
    if (!rule) return { satisfied: true, reason: '', unmetRequirements: [] };
    if (rule.type === 'all') {
      const results = rule.requirements.map(item => evaluatePrerequisite(item, context));
      return { satisfied: results.every(result => result.satisfied), reason: results.filter(result => !result.satisfied).map(result => result.reason).join('; '), unmetRequirements: results.flatMap(result => result.unmetRequirements) };
    }
    if (rule.type === 'any') {
      const results = rule.requirements.map(item => evaluatePrerequisite(item, context));
      const winner = results.find(result => result.satisfied);
      return winner || { satisfied: false, reason: results.map(result => result.reason).join(' OR '), unmetRequirements: results.flatMap(result => result.unmetRequirements) };
    }
    if (rule.type === 'external') return { satisfied: true, reason: '', unmetRequirements: [] };
    if (rule.type === 'standing') {
      const satisfied = rule.value.endsWith('_section') ? context.sections.has(rule.value) : context.standing === rule.value;
      return { satisfied, reason: satisfied ? '' : `Requires ${rule.value}`, unmetRequirements: satisfied ? [] : [rule.value] };
    }
    if (rule.type === 'min_credit_hours') {
      const satisfied = context.completedCredits >= rule.value;
      return { satisfied, reason: satisfied ? '' : `Requires at least ${rule.value} qualifying credit hours`, unmetRequirements: satisfied ? [] : [String(rule.value)] };
    }
    if (rule.type === 'course') {
      const slots = resolvePrerequisiteSlots(context.programId, rule.code, rule.slotId || null);
      if (slots.length === 0) {
        const satisfied = context.satisfiedReferenceCodes.has(rule.code);
        return { satisfied, reason: satisfied ? '' : `Requires ${rule.code}`, unmetRequirements: satisfied ? [] : [rule.code] };
      }
      if (slots.length > 1 && rule.match !== 'any') return { satisfied: false, reason: `Ambiguous prerequisite ${rule.code}`, unmetRequirements: [rule.code] };
      const status = getStatus(context.programId, slots[0]);
      const satisfied = status === 'completed' || (rule.allowConcurrent === true && status === 'in_progress');
      return { satisfied, reason: satisfied ? '' : `Requires ${rule.code}${rule.allowConcurrent ? ' completed or in progress' : ''}`, unmetRequirements: satisfied ? [] : [rule.code] };
    }
    return { satisfied: false, reason: 'Unknown prerequisite rule', unmetRequirements: [] };
  }

  function evaluateCourseEligibility(programId, course) {
    const context = { ...eligibilityContext, programId, completedCredits: getCompletedQualifyingCredits(programId) };
    return evaluatePrerequisite(course.prerequisiteRule, context);
  }

  function getMissingPrerequisites(programId, course) {
    return evaluateCourseEligibility(programId, course).unmetRequirements;
  }

  function getCoursePrerequisiteSlots(programId, course) {
    const slots = [];
    const collect = rule => {
      if (!rule) return;
      if (rule.type === 'all' || rule.type === 'any') return rule.requirements.forEach(collect);
      if (rule.type !== 'course') return;
      const matches = resolvePrerequisiteSlots(programId, rule.code);
      if (matches.length === 1) slots.push(matches[0]);
    };
    collect(course.prerequisiteRule);
    return slots;
  }

  function runPrerequisiteSelfTests() {
    const originalProgress = progress;
    const originalContext = { standing: eligibilityContext.standing, sections: eligibilityContext.sections, satisfiedReferenceCodes: eligibilityContext.satisfiedReferenceCodes };
    const assert = (condition, label) => { if (!condition) throw new Error(`Prerequisite self-test failed: ${label}`); };
    const course = (programId, code) => normalizedCourses[programTrackIds[programId] || programId].find(item => item.code === code && !item.referenceOnly);
    try {
      progress = { ai: {} };
      const ai201 = course('ai', 'AIS 201'), ai331 = course('ai', 'CSCI 331'), ais301 = course('ai', 'AIS 301');
      progress.ai[ai201.slotId] = 'completed';
      assert(!evaluateCourseEligibility('ai', ais301).satisfied, 'AIS 301 requires both AIS 201 and CSCI 331');
      progress.ai[ai331.slotId] = 'completed';
      assert(evaluateCourseEligibility('ai', ais301).satisfied, 'AIS 301 becomes eligible when both courses are complete');

      progress = { bmd: {} };
      const bmd100 = normalizedCourses.biomedical.find(item => item.code === 'BMD 100');
      const bmd101 = course('bmd', 'BMD 101'), bmd102 = course('bmd', 'BMD 102'), bmd211 = course('bmd', 'BMD 211');
      progress.bmd[bmd100.slotId] = 'completed';
      assert(evaluateCourseEligibility('bmd', bmd101).satisfied, 'BMD 101 accepts BMD 100');
      delete progress.bmd[bmd100.slotId];
      eligibilityContext.sections = new Set(['science_section']);
      assert(evaluateCourseEligibility('bmd', bmd101).satisfied, 'BMD 101 accepts Science Section');
      eligibilityContext.sections = new Set();
      assert(!evaluateCourseEligibility('bmd', bmd101).satisfied, 'BMD 101 blocks without either OR branch');
      progress.bmd[bmd101.slotId] = 'in_progress';
      assert(evaluateCourseEligibility('bmd', bmd102).satisfied, 'BMD 102 allows concurrent BMD 101');
      delete progress.bmd[bmd101.slotId];
      assert(!evaluateCourseEligibility('bmd', bmd102).satisfied, 'BMD 102 blocks without BMD 101');
      const bmdCsci231 = course('bmd', 'CSCI 231');
      assert(!evaluateCourseEligibility('bmd', bmd211).satisfied, 'BMD 211 blocks without CSCI 231');
      progress.bmd[bmdCsci231.slotId] = 'in_progress';
      assert(evaluateCourseEligibility('bmd', bmd211).satisfied, 'BMD 211 allows concurrent CSCI 231 when in progress');

      eligibilityContext.standing = 'freshman';
      const training = normalizedCourses.ai.find(item => item.code === 'AIS 291');
      assert(!evaluateCourseEligibility('ai', training).satisfied, 'Training I blocks below sophomore standing');
      eligibilityContext.standing = 'sophomore';
      assert(evaluateCourseEligibility('ai', training).satisfied, 'Training I accepts sophomore standing');
      eligibilityContext.standing = 'freshman';
      const trainingII = normalizedCourses.ai.find(item => item.code === 'AIS 391');
      assert(!evaluateCourseEligibility('ai', trainingII).satisfied, 'Training II blocks below junior standing');
      eligibilityContext.standing = 'junior';
      assert(evaluateCourseEligibility('ai', trainingII).satisfied, 'Training II accepts junior standing');

      assert(!evaluatePrerequisite({ type: 'min_credit_hours', value: 87 }, { completedCredits: 86 }).satisfied, 'Senior Project I blocks below 87 credits');
      assert(evaluatePrerequisite({ type: 'min_credit_hours', value: 87 }, { completedCredits: 87 }).satisfied, 'Senior Project I accepts 87 credits');
      progress.ai = {};
      const ais493 = course('ai', 'AIS 493'), ais494 = course('ai', 'AIS 494');
      progress.ai[ais493.slotId] = 'completed';
      assert(evaluateCourseEligibility('ai', ais494).satisfied, 'Senior Project II requires completed Senior Project I');
      delete progress.ai[ais493.slotId];
      assert(!evaluateCourseEligibility('ai', ais494).satisfied, 'Senior Project II blocks without Senior Project I');
      const duplicateSlots = resolvePrerequisiteSlots('ai', 'AIS 401');
      assert(duplicateSlots.length === 2, 'Duplicate AIS 401 slots remain distinct');
      progress.ai[duplicateSlots[0]] = 'completed';
      assert(!evaluatePrerequisite({ type: 'course', code: 'AIS 401' }, { programId: 'ai' }).satisfied, 'One duplicate slot does not satisfy an ambiguous duplicate-code requirement');
    } finally {
      progress = originalProgress;
      eligibilityContext.standing = originalContext.standing;
      eligibilityContext.sections = originalContext.sections;
      eligibilityContext.satisfiedReferenceCodes = originalContext.satisfiedReferenceCodes;
    }
  }

  function validatePrerequisites() {
    let changed = false;

    let passChanged;
    do {
      passChanged = false;

    Object.values(PROGRAMS).forEach(prog => {
        const statuses = progress[prog.id] || {};

        prog.courses.forEach(course => {
        if (statuses[course.slotId] !== 'completed') return;

          const hasIncompletePrereq = getMissingPrerequisites(prog.id, course).length > 0;

          if (hasIncompletePrereq) {
          delete statuses[course.slotId];
            changed = true;
            passChanged = true;
          }
        });
      });
    } while (passChanged);

    if (changed) {
      saveProgress();
      refreshUI();
    }

    return changed;
  }
  function cycleStatus(programId, slotId) {
    const prog = PROGRAMS[programId];
    const course = getProgramCourse(programId, slotId);
    const missing = course ? getMissingPrerequisites(programId, course) : [];

    if (missing.length) {
      checkPrereqWarning(course);

      document.querySelectorAll('.course-card').forEach(card => {
        if (missing.includes(card.dataset.code)) {
          card.classList.add(
            'ring-2',
            'ring-yellow-500',
            'shadow-[0_0_15px_rgba(234,179,8,0.3)]',
            'transition-all',
            'duration-300'
          );

          setTimeout(() => {
            card.classList.remove(
              'ring-2',
              'ring-yellow-500',
              'shadow-[0_0_15px_rgba(234,179,8,0.3)]'
            );
          }, 3000);
        }
      });
      return;
    }

    const order = ['not_started', 'in_progress', 'completed'];
    const cur = getStatus(programId, slotId);
    const next = order[(order.indexOf(cur) + 1) % 3];
    if (!progress[programId]) progress[programId] = {};
    if (next === 'not_started') delete progress[programId][slotId];
    else progress[programId][slotId] = next;
    saveProgress();
    validatePrerequisites();
    refreshUI();
  }

  function coursesForProgram(prog, trackId) {
    return prog.courses.filter(co => {
      if (co.referenceOnly) return false;
      if (VIRTUAL_CODES.includes(co.code)) return true;
      if (co.trackOnly && co.trackOnly !== trackId && prog.id === 'cs') {
        if (co.elective) return false;
      }
      return true;
    });
  }

  function buildCourseGrid(prog, trackId, statuses) {
    const courses = coursesForProgram(prog, trackId);
    const studyPlan = prog.studyPlan || [];
    
    // Core course filter - exclude university requirements and open electives
    const isCoreCourse = (co) => {
      if (VIRTUAL_CODES.includes(co.code)) return false;
      if (co.category === 'university' && !co.code.startsWith('ENGL')) return false;
      if (co.elective && !co.trackOnly && co.category !== 'humanities') return false;
      
      const coreCategories = ['math', 'basic_computing', 'specialization', 'training', 'project'];
      return co.category === 'humanities' ||
             co.code.startsWith('ENGL') ||
             coreCategories.includes(co.category) || 
             co.code.startsWith('MATH') || 
             co.code.startsWith('PHYS') || 
             co.code.startsWith('ECEN') ||
             co.code.startsWith('CSCI') ||
             co.code.startsWith('AIS') ||
             co.code.startsWith('CSEC') ||
             co.code.startsWith('BMD');
    };

    // View filters use the exact category values stored on each course object.
    const catFilter = {
      full: () => true,
      core: co => ['basic_computing', 'specialization', 'project'].includes(co.category),
      math: co => co.category === 'math' || co.code.startsWith('MATH') || co.code === 'PHYS 101' || co.code === 'ECEN 111',
      spec: co => co.category === 'specialization',
      'english-electives': co =>
        co.code.startsWith('ENGL') ||
        co.category === 'humanities' ||
        co.elective === true ||
        co.category === 'elective'
    };
    const filterFn = catFilter[treeView] || catFilter.full;

    const filteredCourses = courses.filter(isCoreCourse);
    const codeSet = new Set(filteredCourses.map(x => x.code));

    const grid = document.getElementById('courseGrid');
    grid.innerHTML = '';

    // Build semester sections
    studyPlan.forEach(semester => {
      const semesterSection = document.createElement('div');
      semesterSection.className = 'semester-section';
      
      const semesterHeader = document.createElement('h3');
      semesterHeader.className = 'semester-header';
      semesterHeader.textContent = semester.label;
      semesterSection.appendChild(semesterHeader);

      const semesterGrid = document.createElement('div');
      semesterGrid.className = 'semester-grid';

      semester.courses.forEach(slotId => {
        // Handle placeholder codes like 'CSCI 3xx track'
        const course = getProgramCourse(currentProgram, slotId);
        if (!course || !isCoreCourse(course)) return;

        // Category views are true filters: omit non-matching cards entirely.
        if (treeView !== 'full' && !filterFn(course)) return;

        const st = statuses[course.slotId] || 'not_started';
        const card = document.createElement('div');

        card.className = `course-card ${st === 'completed' ? 'completed' : st === 'in_progress' ? 'in-progress' : ''}`;
        card.dataset.code = course.code;
        card.dataset.slotId = course.slotId;
        
        // Find prerequisites and courses this unlocks
        const prereqs = course.prereqs.filter(pr => codeSet.has(pr) && !VIRTUAL_CODES.includes(pr));
        const prerequisiteSlots = getCoursePrerequisiteSlots(currentProgram, course);
        const unlocks = filteredCourses
          .filter(candidate => getCoursePrerequisiteSlots(currentProgram, candidate).includes(course.slotId))
          .map(candidate => candidate.slotId);
        
        card.innerHTML = `
          <div class="course-card-header">
            <div class="course-code">${course.code}</div>
            <div class="course-credits">${course.credits} cr</div>
            <div class="course-category">${course.category.replace('_', ' ')}</div>
          </div>
          <div class="course-title">${course.titleEn}</div>
          <div class="course-status ${st === 'completed' ? 'completed' : st === 'in_progress' ? 'in-progress' : 'not-started'}">
            ${st === 'completed' ? '✔️ Completed' : st === 'in_progress' ? '⏳ In Progress' : '○ Not Started'}
          </div>
          ${(course.prereqText || prereqs.length > 0) ? `<div class="course-prereqs">Prereqs: <span>${course.prereqText || prereqs.join(', ')}</span></div>` : ''}
        `;

        // Click to cycle status
        card.addEventListener('click', () => {
          cycleStatus(currentProgram, course.slotId);
        });

        // Hover effects for prerequisite highlighting
        card.addEventListener('mouseenter', () => {
          highlightedCourse = course.code;
          document.querySelectorAll('.course-card').forEach(c => {
            if (c.dataset.slotId === course.slotId) return;
            
            // Highlight prerequisites (amber)
            if (prerequisiteSlots.includes(c.dataset.slotId)) {
              c.classList.add('highlight-prereq');
              c.classList.remove('dimmed');
            }
            // Highlight courses this unlocks (green)
            else if (unlocks.includes(c.dataset.slotId)) {
              c.classList.add('highlight-unlock');
              c.classList.remove('dimmed');
            }
            // Dim unrelated cards significantly
            else {
              c.classList.add('dimmed');
            }
          });
        });

        card.addEventListener('mouseleave', () => {
          highlightedCourse = null;
          document.querySelectorAll('.course-card').forEach(c => {
            c.classList.remove('highlight-prereq', 'highlight-unlock', 'dimmed');
          });
        });

        semesterGrid.appendChild(card);
      });

      if (semesterGrid.children.length > 0) {
        semesterSection.appendChild(semesterGrid);
        grid.appendChild(semesterSection);
      }
    });
  }

  function checkPrereqWarning(course) {
    const alert = document.getElementById('prereqAlert');
    const st = getStatus(currentProgram, course.slotId);
    if (st === 'not_started') { alert.classList.remove('show'); return; }
    const missing = getMissingPrerequisites(currentProgram, course);
    if (missing.length) {
      alert.textContent = `Warning: ${course.code} marked ${st} but prerequisites not completed: ${missing.join(', ')}`;
      alert.classList.add('show');
    } else alert.classList.remove('show');
  }

  function computeProgress(prog, trackId) {
    const courses = coursesForProgram(prog, trackId);
    const statuses = progress[prog.id] || {};
    let gpaDone = 0, totalDone = 0;
    const byCat = {};
    courses.forEach(co => {
      if (VIRTUAL_CODES.includes(co.code)) return;
      const st = statuses[co.slotId];
      if (st !== 'completed') return;
      if (co.countsGpa !== false) gpaDone += co.credits;
      totalDone += co.credits;
      byCat[co.category] = (byCat[co.category] || 0) + co.credits;
    });
    return {
      gpaDone,
      gpaTotal: prog.graduation.gpaCredits,
      totalDone,
      totalRequired: prog.graduation.total,
      byCat,
      percentGpa: Math.min(100, (gpaDone / prog.graduation.gpaCredits) * 100),
      percentTotal: Math.min(100, (totalDone / prog.graduation.total) * 100)
    };
  }

  function renderMajorGrid() {
    const grid = document.getElementById('majorGrid');
    grid.innerHTML = Object.values(PROGRAMS).map(p => `
      <div class="major-card" data-id="${p.id}">
        <div class="code">${p.id.toUpperCase()}</div>
        <h3>${p.nameEn}</h3>
        <p style="font-size:0.8rem;color:var(--muted);margin-top:8px;">138 credits · 132 GPA</p>
      </div>
    `).join('');
    grid.querySelectorAll('.major-card').forEach(card => {
      card.addEventListener('click', () => selectProgram(card.dataset.id));
    });
  }

  function resetProgress() {
    if (!confirm('Are you sure you want to reset all your completed courses? This cannot be undone.')) {
      return;
    }
    progress = {};
    saveProgress();
    document.getElementById('prereqAlert').classList.remove('show');
    if (currentProgram) {
      refreshUI();
    }
  }

  window.resetProgress = resetProgress;

  function selectProgram(id) {
    currentProgram = id;
    document.querySelectorAll('.major-card').forEach(c => c.classList.toggle('active', c.dataset.id === id));
    document.getElementById('dashboard').classList.remove('hidden');
    const prog = PROGRAMS[id];
    document.getElementById('trackSection').classList.toggle('hidden', !prog.tracks);
    if (prog.tracks) renderTracks(prog);
    refreshUI();
    document.getElementById('dashboard').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function renderTracks(prog) {
    const pills = document.getElementById('trackPills');
    pills.innerHTML = prog.tracks.map(t => `
      <button type="button" class="pill ${t.id === currentTrack ? 'active' : ''}" data-track="${t.id}">
        ${t.nameEn}
      </button>
    `).join('');
    pills.querySelectorAll('.pill').forEach(p => {
      p.addEventListener('click', () => {
        currentTrack = p.dataset.track;
        pills.querySelectorAll('.pill').forEach(x => x.classList.toggle('active', x.dataset.track === currentTrack));
        refreshUI();
      });
    });
  }

  function refreshUI() {
    if (!currentProgram) return;
    const prog = PROGRAMS[currentProgram];
    const p = computeProgress(prog, currentTrack);
    const statuses = progress[currentProgram] || {};

    document.getElementById('programTitle').textContent = prog.nameEn;
    document.getElementById('programMission').textContent = prog.mission;

    document.getElementById('statsRow').innerHTML = `
      <div class="stat-box"><div class="val">${Math.round(p.percentGpa)}%</div><div class="lbl">GPA Credits</div></div>
      <div class="stat-box"><div class="val">${p.gpaDone}</div><div class="lbl">of 132 cr</div></div>
      <div class="stat-box"><div class="val">${Math.round(p.percentTotal)}%</div><div class="lbl">Total Degree</div></div>
      <div class="stat-box"><div class="val">${prog.courses.filter(c => !VIRTUAL_CODES.includes(c.code) && statuses[c.slotId]==='completed').length}</div><div class="lbl">Courses Done</div></div>
    `;
    document.getElementById('gpaProgress').style.width = p.percentGpa + '%';
    document.getElementById('totalProgress').style.width = p.percentTotal + '%';
    document.getElementById('progressLabel').textContent = `GPA credits: ${p.gpaDone} / ${p.gpaTotal}`;
    document.getElementById('totalLabel').textContent = `Total degree: ${p.totalDone} / ${p.totalRequired} (incl. 6 training)`;

    document.getElementById('breakdownBody').innerHTML = prog.creditBreakdown.map(b => `
      <tr><td>${b.area}</td><td>${b.credits}</td><td>${b.pct}%</td></tr>
    `).join('');

    renderCatalog(prog, statuses);
    renderStudyPlan(prog, statuses);
    buildCourseGrid(prog, currentTrack, statuses);
  }

  function renderCatalog(prog, statuses) {
    const cat = document.getElementById('filterCategory').value;
    const stFilter = document.getElementById('filterStatus').value;
    const searchTerm = document.getElementById('searchInput').value.toLowerCase();
    const tbody = document.getElementById('catalogBody');
    const rows = coursesForProgram(prog, currentTrack)
      .filter(co => !VIRTUAL_CODES.includes(co.code))
      .filter(co => cat === 'all' || co.category === cat)
      .filter(co => {
        const st = statuses[co.slotId] || 'not_started';
        return stFilter === 'all' || st === stFilter;
      })
      .filter(co => {
        if (!searchTerm) return true;
        const codeMatch = co.code.toLowerCase().includes(searchTerm);
        const titleMatch = co.titleEn.toLowerCase().includes(searchTerm);
        return codeMatch || titleMatch;
      })
      .sort((a, b) => a.code.localeCompare(b.code));

    tbody.innerHTML = rows.map(co => {
      const st = statuses[co.slotId] || 'not_started';
      const prereqWarn = getMissingPrerequisites(currentProgram, co).length > 0;
      return `<tr class="${st === 'completed' ? 'row-completed' : ''}" data-slot-id="${co.slotId}">
        <td><strong>${co.code}</strong></td>
        <td>${co.titleEn}${co.trackOnly ? ' <span class="category-badge">track</span>' : ''}${co.elective ? ' <span class="category-badge">elective</span>' : ''}</td>
        <td>${co.credits}</td>
        <td><span class="category-badge">${co.category.replace('_',' ')}</span></td>
        <td>${co.prereqText || co.prereqs.filter(p => !VIRTUAL_CODES.includes(p)).join(', ') || '—'}${prereqWarn && st !== 'not_started' ? '<br><span class="prereq-warn">Prereqs incomplete</span>' : ''}</td>
        <td>
          <div class="status-btns">
            <button type="button" class="status-btn ${st==='completed'?'s-done':st==='in_progress'?'s-progress':''}" data-cycle="${co.slotId}" title="Click to cycle status">${st==='completed'?'✔️':st==='in_progress'?'⏳':'○'}</button>
          </div>
        </td>
      </tr>`;
    }).join('');

    tbody.querySelectorAll('[data-cycle]').forEach(btn => {
      btn.addEventListener('click', () => {
        cycleStatus(currentProgram, btn.dataset.cycle);
      });
    });
  }

  function renderStudyPlan(prog, statuses) {
    const host = document.getElementById('studyPlanHost');
    host.innerHTML = prog.studyPlan.map(sem => {
      const tags = sem.courses.map(slotId => {
        const course = getProgramCourse(currentProgram, slotId);
        if (!course) return '';
        const st = statuses[slotId] || 'not_started';
        const cls = st === 'completed' ? 'done' : '';
        return `<span class="sem-tag ${cls}" data-slot-id="${slotId}">${course.code}</span>`;
      }).join('');
      return `<div class="semester-block"><h4>${sem.label}</h4><div class="sem-tags">${tags}</div>
        <button type="button" class="btn btn-ghost" style="margin-top:8px;font-size:0.75rem;" data-sem-complete="${sem.label}">Mark semester completed</button></div>`;
    }).join('');

    host.querySelectorAll('.sem-tag').forEach(tag => {
      if (!getProgramCourse(currentProgram, tag.dataset.slotId)) return;
      tag.addEventListener('click', () => cycleStatus(currentProgram, tag.dataset.slotId));
    });
    host.querySelectorAll('[data-sem-complete]').forEach(btn => {
      btn.addEventListener('click', () => {
        const sem = prog.studyPlan.find(s => s.label === btn.dataset.semComplete);
        if (!sem) return;
        if (!progress[currentProgram]) progress[currentProgram] = {};
        sem.courses.forEach(slotId => {
          if (getProgramCourse(currentProgram, slotId)) progress[currentProgram][slotId] = 'completed';
        });
        saveProgress();
        validatePrerequisites();
        refreshUI();
      });
    });
  }



  document.querySelectorAll('[data-view]').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('[data-view]').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      treeView = btn.dataset.view;
      refreshUI();
    });
  });

  document.getElementById('filterCategory').addEventListener('change', () => refreshUI());
  document.getElementById('filterStatus').addEventListener('change', () => refreshUI());
  document.getElementById('searchInput').addEventListener('input', () => refreshUI());

  // Sidebar toggle functionality
  const btnOpenRules = document.getElementById('btn-open-rules');
  const rulesBackdrop = document.getElementById('rules-backdrop');
  const rulesSidebar = document.getElementById('rules-sidebar');
  const btnCloseRules = document.getElementById('btn-close-rules');

  function openSidebar() {
    rulesSidebar.classList.remove('translate-x-full');
    rulesSidebar.classList.add('translate-x-0');
    rulesBackdrop.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeSidebar() {
    rulesSidebar.classList.remove('translate-x-0');
    rulesSidebar.classList.add('translate-x-full');
    rulesBackdrop.classList.remove('open');
    document.body.style.overflow = '';
  }

  btnOpenRules.addEventListener('click', openSidebar);
  btnCloseRules.addEventListener('click', closeSidebar);
  rulesBackdrop.addEventListener('click', closeSidebar);

  // Close sidebar on escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && rulesSidebar.classList.contains('translate-x-0')) {
      closeSidebar();
    }
  });

  document.getElementById('exportBtn').addEventListener('click', () => {
    const blob = new Blob([JSON.stringify(progress, null, 2)], { type: 'application/json' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'nu_itcs_progress.json';
    a.click();
  });
  document.getElementById('importBtn').addEventListener('click', () => document.getElementById('importFile').click());
  document.getElementById('importFile').addEventListener('change', e => {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = () => {
      try {
        progress = JSON.parse(reader.result);
        migrateLegacyProgress();
        saveProgress();
        validatePrerequisites();
        refreshUI();
        alert('Progress imported.');
      } catch { alert('Invalid JSON file.'); }
    };
    reader.readAsText(file);
  });
  migrateLegacyProgress();
  validatePrerequisites();
  runPrerequisiteSelfTests();
  renderMajorGrid();
})();
</script>
</body>
</html>
